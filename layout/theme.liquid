<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0">
  <meta name="theme-color" content="{{ settings.color_primary }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Sayfa {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="{{ settings.meta_description_fallback | escape }}">
  {% endif %}

  {% render 'meta-tags' %}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.font_heading.system? == false -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {%- endif -%}

  {%- liquid
    assign body_font_bold = settings.font_body | font_modify: 'weight', 'bold'
    assign body_font_italic = settings.font_body | font_modify: 'style', 'italic'
    assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  %}

  {% style %}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.font_heading | font_face: font_display: 'swap' }}

    :root {
      --color-primary: {{ settings.color_primary }};
      --color-secondary: {{ settings.color_secondary }};
      --color-urgency: {{ settings.color_urgency }};
      --color-success: {{ settings.color_success }};
      --color-info: {{ settings.color_info }};
      --color-background: {{ settings.color_background }};
      --color-background-2: {{ settings.color_background_secondary }};
      --color-background-3: {{ settings.color_background_tertiary }};
      --color-border: {{ settings.color_border }};
      --color-text: {{ settings.color_text_primary }};
      --color-text-2: {{ settings.color_text_secondary }};
      --color-text-muted: {{ settings.color_text_muted }};
      --color-text-on-primary: {{ settings.color_text_on_primary }};

      --font-body-family: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --font-body-style: {{ settings.font_body.style }};
      --font-body-weight: {{ settings.font_body.weight }};
      --font-body-weight-bold: {{ settings.font_body | font_modify: 'weight', 'bold' | default: 700 }};
      --font-heading-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-heading-style: {{ settings.font_heading.style }};
      --font-heading-weight: {{ settings.font_heading.weight }};

      --font-size-base: {{ settings.font_size_base }}px;
      --font-size-xs: 12px;
      --font-size-sm: 13px;
      --font-size-md: {{ settings.font_size_base }}px;
      --font-size-lg: 16px;
      --font-size-xl: 18px;
      --font-size-2xl: 20px;
      --font-size-3xl: 24px;
      --font-size-4xl: 32px;
      --font-size-5xl: 40px;

      --border-radius-sm: 4px;
      --border-radius-md: 8px;
      --border-radius-lg: 12px;
      --border-radius-full: 9999px;

      --shadow-sm: 0 1px 4px rgba(0,0,0,0.04);
      --shadow-md: 0 2px 8px rgba(0,0,0,0.08);
      --shadow-lg: 0 4px 16px rgba(0,0,0,0.12);
      --shadow-xl: 0 8px 32px rgba(0,0,0,0.16);

      --transition-fast: 150ms ease;
      --transition-base: 200ms ease;
      --transition-slow: 300ms ease;

      --header-height: 60px;
      --announcement-height: 36px;
      --container-max-width: 1440px;
      --container-padding: 16px;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      font-size: var(--font-size-base);
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: var(--font-body-family);
      font-style: var(--font-body-style);
      font-weight: var(--font-body-weight);
      color: var(--color-text);
      background-color: var(--color-background);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-heading-family);
      font-style: var(--font-heading-style);
      font-weight: var(--font-heading-weight);
      line-height: 1.2;
      margin: 0 0 0.5em;
      color: var(--color-secondary);
    }

    a { color: inherit; text-decoration: none; }
    a:hover { color: var(--color-primary); }

    img { max-width: 100%; height: auto; display: block; }

    button { cursor: pointer; font-family: inherit; }
    input, textarea, select { font-family: inherit; }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap;
      border: 0;
    }

    .container {
      max-width: var(--container-max-width);
      margin: 0 auto;
      padding: 0 var(--container-padding);
    }

    @media (min-width: 768px) {
      :root { --container-padding: 24px; --header-height: 72px; }
    }

    @media (min-width: 1200px) {
      :root { --container-padding: 40px; }
    }

    .page-wrapper {
      padding-top: calc(var(--header-height) + {% if settings.announcement_bar_enabled %}var(--announcement-height){% else %}0px{% endif %});
    }

    .skeleton {
      background: linear-gradient(90deg, var(--color-background-3) 25%, var(--color-background-2) 50%, var(--color-background-3) 75%);
      background-size: 200% 100%;
      animation: skeleton-loading 1.5s infinite;
      border-radius: var(--border-radius-sm);
    }

    @keyframes skeleton-loading {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    @keyframes pulse-dot {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.5); opacity: 0.6; }
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes slideInLeft {
      from { opacity: 0; transform: translateX(-20px); }
      to   { opacity: 1; transform: translateX(0); }
    }

    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.95); }
      to   { opacity: 1; transform: scale(1); }
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 24px;
      border: 2px solid transparent;
      border-radius: var(--border-radius-md);
      font-size: var(--font-size-md);
      font-weight: 600;
      line-height: 1;
      text-align: center;
      cursor: pointer;
      transition: all var(--transition-base);
      white-space: nowrap;
      text-decoration: none;
      outline: none;
      -webkit-appearance: none;
    }

    .btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

    .btn--primary { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
    .btn--primary:hover { background: #d96a10; border-color: #d96a10; color: #fff; }

    .btn--secondary { background: var(--color-secondary); color: #fff; border-color: var(--color-secondary); }
    .btn--secondary:hover { background: #333; border-color: #333; color: #fff; }

    .btn--outline { background: transparent; color: var(--color-secondary); border-color: var(--color-border); }
    .btn--outline:hover { border-color: var(--color-secondary); }

    .btn--outline-primary { background: transparent; color: var(--color-primary); border-color: var(--color-primary); }
    .btn--outline-primary:hover { background: var(--color-primary); color: #fff; }

    .btn--full { width: 100%; }
    .btn--lg { padding: 16px 32px; font-size: var(--font-size-lg); }
    .btn--sm { padding: 8px 16px; font-size: var(--font-size-sm); }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 8px;
      border-radius: var(--border-radius-sm);
      font-size: var(--font-size-xs);
      font-weight: 700;
      line-height: 1.4;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .badge--sale { background: var(--color-urgency); color: #fff; }
    .badge--new { background: var(--color-success); color: #fff; }
    .badge--bestseller { background: var(--color-primary); color: #fff; }
    .badge--info { background: var(--color-info); color: #fff; }

    .price { font-family: var(--font-heading-family); font-weight: 700; }
    .price--sale { color: var(--color-urgency); }
    .price--compare { text-decoration: line-through; color: var(--color-text-muted); font-weight: 400; }

    .stars { display: inline-flex; gap: 2px; color: #FFB400; }

    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 400;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-slow);
    }

    .overlay.is-active { opacity: 1; pointer-events: all; }

    .drawer {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(400px, 100vw);
      background: var(--color-background);
      z-index: 500;
      transform: translateX(100%);
      transition: transform var(--transition-slow);
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-xl);
    }

    .drawer.is-open { transform: translateX(0); }

    .drawer--left { right: auto; left: 0; transform: translateX(-100%); }
    .drawer--left.is-open { transform: translateX(0); }

    .modal {
      position: fixed;
      inset: 0;
      z-index: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-base);
    }

    .modal.is-open { opacity: 1; pointer-events: all; }

    .modal__content {
      background: var(--color-background);
      border-radius: var(--border-radius-lg);
      max-width: 640px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
      animation: scaleIn var(--transition-base) forwards;
      box-shadow: var(--shadow-xl);
    }

    .modal__close {
      position: absolute;
      top: 12px;
      right: 12px;
      background: none;
      border: none;
      padding: 8px;
      color: var(--color-text-2);
      border-radius: var(--border-radius-sm);
      transition: color var(--transition-fast);
      z-index: 1;
    }

    .modal__close:hover { color: var(--color-text); }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .section-header__title {
      font-size: var(--font-size-3xl);
      font-weight: 800;
      margin: 0;
    }

    .section-header__link {
      font-size: var(--font-size-sm);
      color: var(--color-primary);
      font-weight: 600;
    }

    .section-header__link:hover { text-decoration: underline; }

    .no-js .js-required { display: none !important; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  {% endstyle %}

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'trendify-base.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.Shopify = window.Shopify || {};
    window.Trendify = {
      moneyFormat: {{ shop.money_format | json }},
      currency: {{ cart.currency.iso_code | json }},
      locale: {{ request.locale.iso_code | json }},
      freeShippingThreshold: {{ settings.free_shipping_threshold | times: 100 }},
      standardShippingCost: {{ settings.standard_shipping_cost | times: 100 }},
      cartType: {{ settings.cart_type | json }},
      liveViewersEnabled: {{ settings.live_viewers_enabled | json }},
      liveViewersMin: {{ settings.live_viewers_min }},
      liveViewersMax: {{ settings.live_viewers_max }},
      liveViewersInterval: {{ settings.live_viewers_update_interval | times: 1000 }},
      purchaseToastEnabled: {{ settings.purchase_toast_enabled | json }},
      purchaseToastInterval: {{ settings.purchase_toast_interval | times: 1000 }},
      purchaseToastDuration: {{ settings.purchase_toast_duration | times: 1000 }},
      flashSaleEnabled: {{ settings.flash_sale_enabled | json }},
      flashSaleResetTime: {{ settings.flash_sale_reset_time | json }},
      stockUrgencyHigh: {{ settings.stock_urgency_threshold_high }},
      stockUrgencyCritical: {{ settings.stock_urgency_threshold_critical }},
      recentlyViewedEnabled: {{ settings.recently_viewed_enabled | json }},
      recentlyViewedCount: {{ settings.recently_viewed_count }},
      favoriteCountMin: {{ settings.favorite_count_min }},
      favoriteCountMax: {{ settings.favorite_count_max }}
    };
  </script>

  {%- if settings.ga4_measurement_id != blank -%}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_measurement_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ settings.ga4_measurement_id }}', { send_page_view: false });
  </script>
  {%- endif -%}

  {%- if settings.facebook_pixel_id != blank -%}
  <script>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window, document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '{{ settings.facebook_pixel_id }}');
    fbq('track', 'PageView');
  </script>
  {%- endif -%}

  {{ content_for_header }}
</head>

<body
  class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}"
  data-cart-type="{{ settings.cart_type }}"
>

  <a class="visually-hidden skip-to-content-link btn btn--primary" href="#MainContent">
    İçeriğe Geç
  </a>

  <div class="overlay" id="overlay" aria-hidden="true"></div>

  {%- if settings.announcement_bar_enabled -%}
    {% render 'announcement-bar' %}
  {%- endif -%}

  {% section 'header' %}

  <main id="MainContent" class="main-content page-wrapper" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {%- if settings.cart_type == 'drawer' -%}
    {% render 'cart-drawer' %}
  {%- endif -%}

  {%- if settings.purchase_toast_enabled -%}
    {% render 'recent-purchase-toast' %}
  {%- endif -%}

  <div id="quick-view-modal" class="modal" role="dialog" aria-modal="true" aria-label="Hızlı Bakış" hidden>
    <div class="overlay modal-overlay"></div>
    <div class="modal__content" id="quick-view-content">
      <button class="modal__close" id="quick-view-close" aria-label="Kapat">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="size-guide-modal" class="modal" role="dialog" aria-modal="true" aria-label="Beden Rehberi" hidden>
    <div class="overlay modal-overlay"></div>
    <div class="modal__content">
      <button class="modal__close" id="size-guide-close" aria-label="Kapat">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
      <div id="size-guide-content" style="padding:24px"></div>
    </div>
  </div>

  {%- if settings.recently_viewed_enabled -%}
    <script>
      (function() {
        const key = 'trendify_rv';
        {%- if product -%}
        const item = {
          h: {{ product.handle | json }},
          t: {{ product.title | json }},
          i: {{ product.featured_image | image_url: width: 300 | json }},
          p: {{ product.price }},
          cp: {{ product.compare_at_price | default: 0 }},
          u: {{ product.url | json }},
          v: {{ product.vendor | json }},
          id: {{ product.id }}
        };
        try {
          let rv = JSON.parse(localStorage.getItem(key) || '[]');
          rv = rv.filter(p => p.h !== item.h);
          rv.unshift(item);
          rv = rv.slice(0, {{ settings.recently_viewed_count }});
          localStorage.setItem(key, JSON.stringify(rv));
        } catch(e) {}
        {%- endif -%}
      })();
    </script>
  {%- endif -%}

  {{ 'pubsub.js' | asset_url | script_tag }}
  {{ 'global.js' | asset_url | script_tag }}
  {{ 'details-modal.js' | asset_url | script_tag }}
  {{ 'details-disclosure.js' | asset_url | script_tag }}
  {{ 'cart-drawer.js' | asset_url | script_tag }}
  {{ 'predictive-search.js' | asset_url | script_tag }}
  {{ 'wishlist.js' | asset_url | script_tag }}
  {{ 'recently-viewed.js' | asset_url | script_tag }}
  {{ 'live-viewers.js' | asset_url | script_tag }}
  {{ 'recent-purchase-toast.js' | asset_url | script_tag }}
  {{ 'flash-countdown.js' | asset_url | script_tag }}
  {{ 'quick-view.js' | asset_url | script_tag }}
  {{ 'sticky-atc.js' | asset_url | script_tag }}

  {%- if settings.custom_js != blank -%}
    <script>{{ settings.custom_js }}</script>
  {%- endif -%}

  {%- if settings.custom_css != blank -%}
    <style>{{ settings.custom_css }}</style>
  {%- endif -%}

</body>
</html>
